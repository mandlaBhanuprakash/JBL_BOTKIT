# Kore.ai bot credentials
KORE_BOT_ID=st-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KORE_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KORE_CLIENT_SECRET=<kore-client-secret>
# KORE_BOT_NAME=JBL Assistant   # optional; defaults to config.json salesforce.botName

# Salesforce MIAW
SF_SCRT_BASE_URL=https://<org>.sandbox.my.salesforce-scrt.com
SF_ORG_ID=<salesforce-org-id>
SF_ES_DEVELOPER_NAME=<miaw-deployment-developer-name>

# Salesforce OAuth (Connected App — client credentials)
SF_OAUTH_TOKEN_URL=https://<org>.sandbox.my.salesforce.com/services/oauth2/token
SF_OAUTH_CLIENT_ID=<connected-app-client-id>
SF_OAUTH_CLIENT_SECRET=<connected-app-client-secret>

# Salesforce Apex REST — Kore Create Case (creates Contact + Case, optionally routes)
SF_CASE_URL=https://<org>.sandbox.my.salesforce.com/services/apexrest/kore/create-case
